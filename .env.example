# Gmail API (domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GMAIL_SENDER=noreply@ceed.cloud

# 通知先
NOTIFY_TO=yusaku.takahashi@ceed.cloud

# 資料DLリンク（チームメイト確認待ち）
DOC_URL=

# CORS許可オリジン（チームメイト確認待ち）
ALLOWED_ORIGIN=

# レート制限（任意・Upstash Redis）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# リードダッシュボードのWebhook URL（本番: https://ceed-ad-dashboard.ceed-tokyo-tsushin.workers.dev/webhooks/form、開発: https://ceed-ad-dashboard-dev.ceed-tokyo-tsushin.workers.dev/webhooks/form）
LEADGEN_WEBHOOK_URL=

# リードダッシュボード側と共有する認証シークレット（Worker側の同名シークレットと同じ値にする）
FORM_SHARED_SECRET=
